# =================================================================
# BharatTender Shield / GeM Sentinel — Backend Environment Template
# NEVER commit the real .env file.
# Set these environment variables in your Render Dashboard / Host.
# =================================================================

# Supabase PostgreSQL Connection String
# Use Transaction Pooler (port 6543) or Session Pooler (port 5432)
# Supported schemes: postgresql+psycopg://, postgresql://, postgres://
DATABASE_URL=postgresql+psycopg://postgres.[your-project-ref]:[your-supabase-password]@aws-0-[your-region].pooler.supabase.com:6543/postgres

# JWT Secret Key for authenticating Procurement Officers and Bidders
JWT_SECRET=your_jwt_secret_key_change_in_production

# Google Gemini AI Key (Optional - application runs full deterministic AI verification without it)
GEMINI_API_KEY=your_gemini_api_key

# Frontend URL deployed on Vercel for CORS security
FRONTEND_URL=https://your-vercel-domain.vercel.app

# Additional CORS origins (comma-separated, optional)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://bharattender-shield.vercel.app
